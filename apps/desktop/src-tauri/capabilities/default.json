{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege IPC capability for the ShenDesk main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-login",
    "allow-get-auth-state",
    "allow-logout",
    "allow-health-check",
    "allow-get-config",
    "allow-save-config",
    "allow-reset-config",
    "allow-create-task",
    "allow-get-task-status",
    "allow-list-tasks",
    "allow-cancel-task",
    "allow-read-text-file",
    "allow-index-files",
    "allow-start-file-watch",
    "allow-stop-file-watch",
    "allow-clear-file-cache",
    "allow-compress-images",
    "allow-get-office-engine-status",
    "allow-create-office-document",
    "allow-inspect-office-document",
    "allow-apply-office-operations",
    "allow-render-office-preview",
    "allow-close-office-document",
    "dialog:allow-open",
    "allow-install-plugin",
    "allow-list-plugins",
    "allow-get-plugin",
    "allow-enable-plugin",
    "allow-disable-plugin",
    "allow-execute-plugin-command",
    "allow-uninstall-plugin",
    "allow-check-for-updates",
    "allow-install-update"
  ]
}
